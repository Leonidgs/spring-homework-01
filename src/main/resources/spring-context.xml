<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
           http://www.springframework.org/schema/beans/spring-beans.xsd">

    <bean id="questionDao" class="ru.diasoft.spring.dao.QuestionDaoCsv">
        <constructor-arg value="questions.csv"/>
    </bean>

    <bean id="questionService" class="ru.diasoft.spring.service.QuestionServiceImpl">
        <constructor-arg ref="questionDao"/>
    </bean>

</beans>
